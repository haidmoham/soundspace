# Create an API key with YouTube Data API v3 enabled in Google Cloud Console.
# Browser playback uses the YouTube IFrame Player API and does not need OAuth.
YOUTUBE_API_KEY=

# SQLite cache location. The default is apps/api/.data/soundspace.sqlite.
SOUNDSPACE_DATABASE_PATH=

WEB_ORIGIN=http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=8787
NODE_ENV=development
