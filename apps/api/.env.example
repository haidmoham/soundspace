# Create a Spotify app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# This exact URI must also be registered in the Spotify Dashboard.
# Spotify permits HTTP for explicit loopback addresses, not localhost.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/auth/callback

WEB_ORIGIN=http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=8787
COOKIE_SECRET=replace-with-at-least-32-random-characters
NODE_ENV=development
